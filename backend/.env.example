NODE_ENV=development
BACKEND_PORT=4000
FRONTEND_URL=http://localhost:3000

# Runtime app connection. Use the least-privilege `prodora_app` account
# (SELECT/INSERT/UPDATE/DELETE only), never `prodora_migrate` or root.
# Replace with local credentials in backend/.env only, never commit real values.
DATABASE_URL=mysql://prodora_app:replace_me@localhost:3306/prodora

# Access-token signing secret (Phase 3). Generate a long random value locally,
# e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
# and put it only in backend/.env. Minimum 32 characters.
# Refresh tokens are opaque random strings stored only as SHA-256 hashes,
# so they need no signing secret.
JWT_ACCESS_SECRET=replace_with_a_long_random_secret

# Optional overrides (defaults shown).
# Access-token lifetime in milliseconds (default 900000 = 15 minutes).
JWT_ACCESS_TTL_MS=900000
# Refresh-token/session lifetime in days (default 30).
REFRESH_TOKEN_TTL_DAYS=30
# In-memory rate limits as "max:window" (window units: ms, s, m, h, d).
RATE_LIMIT_REGISTER=5:15m
RATE_LIMIT_LOGIN=5:15m
RATE_LIMIT_REFRESH=5:15m

UPLOAD_DIRECTORY=./uploads
MAX_UPLOAD_SIZE_BYTES=10485760
