# Used only for `npm run db:migrate` / `db:migrate:deploy`, never for the running app.
# Copy to backend/.env.migrate (gitignored) and fill in the real prodora_migrate password.
DATABASE_URL=mysql://prodora_migrate:replace_me@localhost:3306/prodora

# Scoped shadow database used by `prisma migrate dev` to detect schema drift.
SHADOW_DATABASE_URL=mysql://prodora_migrate:replace_me@localhost:3306/prodora_shadow
